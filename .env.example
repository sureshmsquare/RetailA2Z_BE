PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/retaila2z_db
# Set to true to enforce replica set / transaction capability in non-production environments (BRD Section 11)
REQUIRE_REPLICA_SET=true
JWT_ACCESS_SECRET=replace_with_a_secure_jwt_access_secret_key
JWT_REFRESH_SECRET=replace_with_a_secure_jwt_refresh_secret_key
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost

# Billing Configuration
BILLING_ROUND_OFF_MODE=none
BILLING_STOCK_POLICY=block
BILLING_OVERDUE_POLICY=warn
BILLING_MAX_LINES_PER_DRAFT=200
BILLING_MAX_QUANTITY=999999.999
